{{!
    @template block_townsquare/courselist

    This template renders the checkboxes of the course filter. It is used in the filter bar and in the content, so that
    a reload can update the course list (see block_townsquare/filter/coursefilter).

    Variables required for this template:
    * courses - Array of courses that show notifications in townsquare

    Example context (json):
    {
        "courses" : [
            {
                "courseid": 20,
                "coursename": "Course1"
            }
        ]
    }
}}
{{#courses}}
    <div class="form-check">
        <input class="ts_course_checkbox form-check-input" name="ts_course_checkbox" type="checkbox" value="" data-courseid="{{courseid}}" data-coursename="{{coursename}}" id="ts_course_{{courseid}}" checked>
        <label class="form-check-label" for="ts_course_{{courseid}}">
            {{coursename}}
        </label>
    </div>
{{/courses}}
