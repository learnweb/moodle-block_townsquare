{{!
    @template block_townsquare/content

    This template renders the main content area for the townsquare block.

     Variables required for this template:
     * lettergroups - Array with the groups of letters (one per day)
        * lettergroup - The rendered group (see block_townsquare/lettergroup)
     * reloadlabel - Label of the reload button with the time of the last update
     * courses - Array of courses that show notifications in townsquare (for the course filter after a reload)

    The groups are sorted by the server, the letters closest to now come first: today and the upcoming days with the
    earliest letter first, then the past days with the latest letter first.

    Example context (json):
    {
        "reloadlabel": "Reload (last update: 2:30 PM)",
        "courses": [
            {
                "courseid": 3,
                "coursename": "Moodle Engineering"
            }
        ],
        "lettergroups": [
            {
                "lettergroup": "<div class=\"ts-lettergroup mb-2\">Today</div>"
            }
        ]
    }
}}

{{! The course filter is outside of the reloaded content. After a reload, its course list is replaced with this one. }}
<template data-region="ts_course_list">
    {{> block_townsquare/courselist}}
</template>
{{! The reload button shows the time of the last update. After a reload, its label is copied from data-reloadlabel. }}
<div class="townsquare_letters flex-grow-1 overflow-y-scroll overflow-x-hidden pe-2" data-reloadlabel="{{reloadlabel}}">
    {{#lettergroups}}
        {{{lettergroup}}}
    {{/lettergroups}}
    {{! Shown by block_townsquare/filter/filtercontroller if the selected tab has no letters to show. If the course or
        time filter is set, the second line offers to show all letters instead. }}
    <div class="ts_empty d-none text-center text-body-secondary border rounded py-5 px-3" data-tab="ts_tab_posts">
        <div class="icon-size-6 mb-2">{{#pix}}t/messages, core{{/pix}}</div>
        <p class="mb-1">{{#str}}emptyposts, block_townsquare{{/str}}</p>
        <p class="small mb-0" data-region="ts_empty_hint">{{#str}}emptypostshint, block_townsquare{{/str}}</p>
        <p class="small mb-0 d-none" data-region="ts_empty_filtered">
            {{#str}}emptyfiltered, block_townsquare{{/str}}
            <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-action="block_townsquare/show_all">
                {{#str}}showall, block_townsquare{{/str}}
            </button>
        </p>
    </div>
    <div class="ts_empty d-none text-center text-body-secondary border rounded py-5 px-3" data-tab="ts_tab_deadlines">
        <div class="icon-size-6 mb-2">{{#pix}}i/scheduled, core{{/pix}}</div>
        <p class="mb-1">{{#str}}emptydeadlines, block_townsquare{{/str}}</p>
        <p class="small mb-0" data-region="ts_empty_hint">{{#str}}emptydeadlineshint, block_townsquare{{/str}}</p>
        <p class="small mb-0 d-none" data-region="ts_empty_filtered">
            {{#str}}emptyfiltered, block_townsquare{{/str}}
            <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-action="block_townsquare/show_all">
                {{#str}}showall, block_townsquare{{/str}}
            </button>
        </p>
    </div>
</div>