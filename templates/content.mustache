{{!
    @template block_townsquare/content

    This template renders the main content area for the townsquare block.

     Variables required for this template:
     * content - Array with the letters grouped by day
        * day - Day of the group (d.m.Y), used as id
        * daylabel - "Today", "Tomorrow", "Yesterday" or empty
        * daydate - Formatted date of the day
        * count - Number of letters of the day
        * letters - Array with the letters of the day
        * ispast - If the day is before today
        * firstpast - If it is the first past day (the heading "Past" is shown before it)
     * reloadlabel - Label of the reload button with the time of the last update
     * courses - Array of courses that show notifications in townsquare (for the course filter after a reload)

    The days are sorted by the server, the letters closest to now come first: today and the upcoming days with the
    earliest letter first, then the past days with the latest letter first.

    Example context (json):
    {
        "reloadlabel": "Reload (last update: 2:30 PM)",
        "courses": [
            {
                "courseid": 3,
                "coursename": "Moodle Engineering"
            }
        ],
        "content": [
            {
                "day": "31.03.2026",
                "daylabel": "Today",
                "daydate": "Tuesday, 31 March",
                "count": 1,
                "letters": [
                    {
                         "contentid": 0,
                         "isdeadline": true,
                         "coursename": "Moodle Engineering",
                         "courseid": 3,
                         "instancename": "Lesson 1: Quantum Theory",
                         "content": "Lesson 1: Quantum Theory closes",
                         "created": "20.12.2023",
                         "linktocourse": "http://localhost/moodle/course/view.php?id=20",
                         "linktoactivity": "http://localhost/moodle/mod/lesson/view.php?id=314"
                    }
                ]
            }
        ]
    }
}}

{{! The course filter is outside of the reloaded content. After a reload, its course list is replaced with this one. }}
<template data-region="ts_course_list">
    {{> block_townsquare/courselist}}
</template>
{{! The reload button shows the time of the last update. After a reload, its label is copied from data-reloadlabel. }}
<div class="townsquare_letters flex-grow-1 overflow-y-scroll overflow-x-hidden pe-2" data-reloadlabel="{{reloadlabel}}">
    {{#content}}
        {{#firstpast}}
            {{! Separates the upcoming and the past days. Hidden by block_townsquare/filter/filtercontroller if one of
                them has no letters to show. }}
            <div class="ts_past_heading mt-3 mb-2 pt-2 px-2 border-top border-2 fw-bold">
                {{#str}}past, block_townsquare{{/str}}
            </div>
        {{/firstpast}}
        <div class="ts-lettergroup mb-2" id="ts-lettergroup-{{day}}"{{#ispast}} data-past="true"{{/ispast}}>
            <div class="ts_day_header d-flex align-items-center gap-2 px-2 py-1 rounded bg-body-tertiary">
                <span id="ts-daylabel-{{day}}">
                    {{#daylabel}}
                        <span class="fw-bold">{{daylabel}}</span>
                        <span class="small text-body-secondary">{{daydate}}</span>
                    {{/daylabel}}
                    {{^daylabel}}
                        <span class="fw-bold">{{daydate}}</span>
                    {{/daylabel}}
                </span>
                <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis" data-region="ts_day_count">{{count}}</span>
                {{! Bootstrap collapses the day, Moodle's icons-collapse-expand shows the matching chevron. }}
                <button type="button" class="btn btn-icon btn-sm ms-auto icons-collapse-expand" data-bs-toggle="collapse"
                        data-bs-target="#ts-letterbox-{{day}}" aria-expanded="true" aria-controls="ts-letterbox-{{day}}"
                        aria-labelledby="ts-daylabel-{{day}}">
                    <span class="expanded-icon">{{#pix}}t/expandedchevron, core{{/pix}}</span>
                    <span class="collapsed-icon">
                        <span class="dir-rtl-hide">{{#pix}}t/collapsedchevron, core{{/pix}}</span>
                        <span class="dir-ltr-hide">{{#pix}}t/collapsedchevron_rtl, core{{/pix}}</span>
                    </span>
                </button>
            </div>
            <div class="ts-letter-box collapse show list-group list-group-flush" id="ts-letterbox-{{day}}" data-groupid="{{day}}">
                {{#letters}}
                    {{#isdeadline}}
                        {{> block_townsquare/letter/deadlineletter}}
                    {{/isdeadline}}
                    {{#ispost}}
                        {{> block_townsquare/letter/postletter}}
                    {{/ispost}}
                {{/letters}}
            </div>
        </div>
    {{/content}}
    {{! Shown by block_townsquare/filter/filtercontroller if the selected tab has no letters to show. If the course or
        time filter is set, the second line offers to show all letters instead. }}
    <div class="ts_empty d-none text-center text-body-secondary border rounded py-5 px-3" data-tab="ts_tab_posts">
        <div class="icon-size-6 mb-2">{{#pix}}t/messages, core{{/pix}}</div>
        <p class="mb-1">{{#str}}emptyposts, block_townsquare{{/str}}</p>
        <p class="small mb-0" data-region="ts_empty_hint">{{#str}}emptypostshint, block_townsquare{{/str}}</p>
        <p class="small mb-0 d-none" data-region="ts_empty_filtered">
            {{#str}}emptyfiltered, block_townsquare{{/str}}
            <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-action="block_townsquare/show_all">
                {{#str}}showall, block_townsquare{{/str}}
            </button>
        </p>
    </div>
    <div class="ts_empty d-none text-center text-body-secondary border rounded py-5 px-3" data-tab="ts_tab_deadlines">
        <div class="icon-size-6 mb-2">{{#pix}}i/scheduled, core{{/pix}}</div>
        <p class="mb-1">{{#str}}emptydeadlines, block_townsquare{{/str}}</p>
        <p class="small mb-0" data-region="ts_empty_hint">{{#str}}emptydeadlineshint, block_townsquare{{/str}}</p>
        <p class="small mb-0 d-none" data-region="ts_empty_filtered">
            {{#str}}emptyfiltered, block_townsquare{{/str}}
            <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-action="block_townsquare/show_all">
                {{#str}}showall, block_townsquare{{/str}}
            </button>
        </p>
    </div>
</div>