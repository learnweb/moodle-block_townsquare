{{!
    @template block_townsquare/main

    This template renders the main area for the townsquare block.

     Variables required for this template:
     * timespans - Time spans of the time filter, each with id, timespan (seconds) and label
     * The variables of block_townsquare/content (lettergroups, courses, reloadlabel)

    Example context (json):
    {
        "reloadlabel": "Reload (last update: 2:30 PM)",
        "timespans": [
            {
                "id": "ts_time_week",
                "timespan": 604800,
                "label": "1 week"
            }
        ],
        "courses": [
            {
                "courseid": 3,
                "coursename": "Moodle Engineering"
            }
        ],
        "lettergroups": [
            {
                "lettergroup": "<div class=\"ts-lettergroup mb-2\">Today</div>"
            }
        ]
    }
}}
<div id="townsquare_root">
    {{> block_townsquare/filterbar}}

    <div class="townsquare_content d-flex flex-column overflow-hidden" id="ts_feed">
        {{> block_townsquare/content}}
    </div>
</div>
