{{!
    @template block_townsquare/letter/deadlineletter

    This template renders a deadline letter as a compact row. Several deadlines of the same course and module at the
    same time are shown as a list.

    Variables required for this template (more variables are available for testing and future features):
    * contentid - Unique identification for every shown plugin content
    * isdeadline - Variable for the content template to assure this template is used.
    * coursename - Name of the course
    * courseid - Id of the course
    * instancename - Name of the instance
    * content - What happens at the deadline
    * created - Time of the deadline
    * createdtimestamp - Timestamp of the deadline
    * linktocourse - Link to the course
    * linktoactivity - Link to the module instance
    * activityicon - Activity icon of the module (see core_course/activity_icon)
    * grouped - If the letter shows several deadlines
    * deadlines - The grouped deadlines, each with name and linktoactivity

    Example context (json):
    {
          "contentid": 0,
          "isdeadline": true,
          "coursename": "Moodle Engineering",
          "courseid": 3,
          "instancename": "Lesson 1: Quantum Theory",
          "content": "Lesson 1: Quantum Theory closes",
          "created": "14:00",
          "createdtimestamp": 1703080800,
          "linktocourse": "http://localhost/moodle/course/view.php?id=20",
          "linktoactivity": "http://localhost/moodle/mod/lesson/view.php?id=314",
          "activityicon": {
              "icon": "http://localhost/moodle/theme/image.php/boost/lesson/1/monologo",
              "iconclass": "activityicon",
              "modname": "lesson",
              "pluginname": "Lesson",
              "purpose": "content",
              "branded": false,
              "extraclasses": "smaller"
          },
          "grouped": false,
          "deadlines": []
    }
}}
<div class="townsquare_letter deadlineletter list-group-item bg-transparent px-2" id="content-nr-{{contentid}}">
    <div class="d-flex align-items-start gap-3">
        <div class="flex-shrink-0">{{#activityicon}}{{> core_course/activity_icon}}{{/activityicon}}</div>
        <div class="flex-grow-1 text-break">
            <div>
                {{#grouped}}
                    <ul class="list-unstyled mb-0">
                        {{#deadlines}}
                            <li><a href="{{linktoactivity}}">{{name}}</a></li>
                        {{/deadlines}}
                    </ul>
                {{/grouped}}
                {{^grouped}}
                    {{content}}
                {{/grouped}}
            </div>
            <div class="small text-body-secondary">
                <span class="townsquareletter_course" data-courseid="{{courseid}}">
                    <a href="{{linktocourse}}">{{coursename}}</a>
                </span>
                {{^grouped}}
                    &rsaquo; <a href="{{linktoactivity}}">{{instancename}}</a>
                {{/grouped}}
            </div>
        </div>
        <div class="townsquareletter_date small text-body-secondary text-nowrap text-end" data-created="{{createdtimestamp}}">
            {{created}}
            <div class="d-none" data-region="ts_relativetime" data-timestamp="{{createdtimestamp}}"></div>
        </div>
    </div>
</div>
