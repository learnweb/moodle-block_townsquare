{{!
    @template block_townsquare/letter/activitycompletionletter

    This template renders an activity completion letter as a compact row.

    Variables required for this template (more variables are available for testing and future features):
    * contentid - Unique identification for every shown plugin content
    * isactivitycompletion - Variable for the blockcontent template to assure this template is used.
    * coursename - Name of the course
    * courseid - Id of the course
    * instancename - Name of the instance
    * created - Time of the expected completion
    * createdtimestamp - Timestamp of the expected completion
    * linktocourse - Link to the course
    * linktoactivity - Link to the module instance
    * activityicon - Activity icon of the module (see core_course/activity_icon)

    Example context (json):
    {
        "contentid": 28,
        "isactivitycompletion": true,
        "coursename": "Moodle Engineering",
        "courseid": 3,
        "modulename": "survey",
        "instancename": "How difficult was the exam?",
        "created": "23:59",
        "createdtimestamp": 1698530340,
        "linktoactivity": "http://localhost/moodle/mod/survey/view.php?id=72",
        "linktocourse": "http://localhost/moodle/course/view.php?id=3",
        "activityicon": {
            "icon": "http://localhost/moodle/theme/image.php/boost/survey/1/monologo",
            "iconclass": "activityicon",
            "modname": "lesson",
            "pluginname": "Lesson",
            "purpose": "content",
            "branded": false,
            "extraclasses": "smaller"
        }
    }
}}
<div class="townsquare_letter completionletter list-group-item bg-transparent px-2" id="content-nr-{{contentid}}">
    <div class="d-flex align-items-start gap-3">
        <div class="flex-shrink-0">{{#activityicon}}{{> core_course/activity_icon}}{{/activityicon}}</div>
        <div class="flex-grow-1 text-break">
            <div>
                {{#str}} completionletterorigin, block_townsquare, {
                    "modulename": {{#quote}} <a href='{{linktoactivity}}'>{{instancename}}</a> {{/quote}} }
                {{/str}}
            </div>
            <div class="small text-body-secondary">
                <span class="townsquareletter_course" data-courseid="{{courseid}}">
                    <a href="{{linktocourse}}">{{coursename}}</a>
                </span>
            </div>
        </div>
        <div class="townsquareletter_date small text-body-secondary text-nowrap" data-created="{{createdtimestamp}}">
            {{created}}
        </div>
    </div>
</div>
